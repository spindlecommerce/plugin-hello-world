{
  "name": "@spindlecommerce/plugin-hello-world",
  "version": "1.0.0",
  "description": "A SpindleCommerce plugin that adds a greeting to every new order's history: a small, complete plugin to start your own from.",
  "keywords": [
    "spindlecommerce",
    "spindlecommerce-plugin"
  ],
  "homepage": "https://github.com/spindlecommerce/plugin-hello-world#readme",
  "bugs": "https://github.com/spindlecommerce/plugin-hello-world/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spindlecommerce/plugin-hello-world.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.12"
  },
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@spindlecommerce/plugin-sdk": "^1.0.0"
  },
  "devDependencies": {
    "@spindlecommerce/plugin-sdk": "^1.0.0",
    "@types/node": "^24",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
